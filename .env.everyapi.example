# Copy to .env.everyapi. This file contains no working credentials.
EVERYAPI_BIND_IP=127.0.0.1
EVERYAPI_PORT=8080
# Optional: public HTTPS origin for the URLs shown in the Gateway page.
EVERYAPI_PUBLIC_URL=
EVERYAPI_REGION=global
# Optional: self-hosted origin, optionally ending in /v1.
EVERYAPI_API_BASE=
# Optional: enter the upstream API key here or in the Providers page after startup.
EVERYAPI_API_KEY=
# Optional: independent random keys. If blank, generated keys persist in the data volume.
EVERYAPI_WEB_KEY=
EVERYAPI_GATEWAY_KEY=
